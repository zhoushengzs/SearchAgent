# 复制为 local_training.env 后填写；不要把真实密钥发给朋友或写进聊天。
# 网页和文字找图片使用 Serper；网页内容直接读取，无需图片上传服务。
# 多密钥按 JSON 数组顺序使用，例如 SERPER_API_KEYS='["第一把", "第二把"]'
# 留空时仍兼容单把 SERP_API_KEY / SERPER_API_KEY 以及编号变量。
SERPER_API_KEYS=""
SERP_API_KEY=""

# 答案评分：填写自己的 OpenAI 兼容服务完整地址、密钥和模型名。
# 同一个地址会自动补到框架的两个评分入口。
JUDGE_BASE_URL=""
JUDGE_API_KEY=""
JUDGE_MODEL=""
# DeepSeek 可填 deepseek-flash；对应地址 https://api.deepseek.com/v1。
# 只有服务支持时才填写 enabled 或 disabled；DeepSeek 评分建议 disabled。
JUDGE_THINKING=""
